# 仅本地运行使用：复制为 agent.py 旁边的 .env，取消注释其中一组并填上密钥。
# .env 不会被打包，也绝不能提交到仓库。平台上请在「密钥与网络」里添加模型服务。
# Local runs only: copy to .env next to agent.py, uncomment ONE group and fill in the key. Never commit .env.

# --- 任意 OpenAI 兼容服务，前缀自取（例如 MINIMAX、DEEPSEEK、KIMI、OPENAI） ---
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=<OpenAI 兼容地址>
# MINIMAX_MODEL=<模型名>

# --- DeepSeek（地址和模型可省略，默认 https://api.deepseek.com / deepseek-chat） ---
# DEEPSEEK_API_KEY=

# --- Anthropic ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# 配了多组时按 KIMI、OPENAI、DEEPSEEK、MOONSHOT、其他前缀、ANTHROPIC 的顺序选用，连续失败自动换下一组。
# 只用某一组：
# AO_LLM_PREFIX=MINIMAX

# 不用模型（纯规则）：
# OBSERVER_MODEL_DISABLED=1
# 关闭值班日志环节（消融）：
# AO_DUTY_LOG=0
